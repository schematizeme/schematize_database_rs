import { LineEdit, ScrollView } from "std-widgets.slint";

// Janela do schematize-database. Casca visual fina: todos os dados vêm do binário
// `schematize-database` (headless), por `--json`, e as ações que escrevem abrem TERMINAL.
//
// O TEMA e o `Btn` são cópia das janelas irmãs. Isso é PLATAFORMA (D4): não sabem o que é
// tabela, coluna ou FK — sabem cor, borda e clique. Se um dia algo de domínio migrar para cá,
// o corte foi feito errado.

global Th {
    in-out property <bool> dark: true;
    out property <color> bg:          dark ? #14161c : #e8ecf4;
    out property <color> surface:     dark ? #1b1e27 : #ffffff;
    out property <color> surface-2:   dark ? #222634 : #dce3f0;
    out property <color> border:      dark ? #2b3040 : #bfc9dc;
    out property <color> text:        dark ? #e6e9f2 : #12151d;
    out property <color> text-dim:    dark ? #8a90a2 : #475062;
    out property <color> accent:      #5b8cff;
    out property <color> accent-soft: dark ? #2a3a66 : #cedcff;
    out property <color> good:        #3ecf8e;
    out property <color> warn:        #e6b23a;
    out property <color> header-fg:   dark ? #9db4ff : #2b48bd;
}

component Btn inherits Rectangle {
    in property <string> label;
    in property <bool> primary: false;
    in property <bool> enabled: true;
    callback clicked();
    height: 38px;
    border-radius: 9px;
    border-width: primary ? 0px : 1px;
    border-color: Th.border;
    background: !enabled ? Th.surface-2
        : primary ? (touch.has-hover ? #6f9bff : Th.accent)
        : (touch.has-hover ? Th.accent-soft : Th.surface);
    opacity: enabled ? 1.0 : 0.5;
    animate background { duration: 120ms; }
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        Text {
            text: label;
            vertical-alignment: center;
            horizontal-alignment: center;
            color: primary ? #ffffff : Th.text;
            font-size: 13.5px;
            font-weight: 600;
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }
}

export struct ColunaUI { nome: string, tipo: string, marcas: string }
export struct TabelaUI {
    nome: string,
    colunas: [ColunaUI],
    // Uma linha por FK e por índice, já formatadas no Rust: a tela desenha, não decide.
    fks: [string],
    indices: [string],
}
export struct ArestaUI { de: string, para: string, coluna: string }

// Uma tabela, com colunas, FKs e índices.
component FichaTabela inherits Rectangle {
    in property <TabelaUI> t;
    border-radius: 10px;
    border-width: 1px;
    border-color: Th.border;
    background: Th.surface;
    height: corpo.preferred-height;
    corpo := VerticalLayout {
        padding: 12px;
        spacing: 6px;
        Text {
            text: t.nome;
            font-size: 14px;
            font-weight: 800;
            color: Th.text;
        }
        for c in t.colunas: HorizontalLayout {
            spacing: 8px;
            Text { text: c.nome; font-size: 12.5px; color: Th.text; width: 180px; }
            Text { text: c.tipo; font-size: 12px; color: Th.text-dim; width: 110px; }
            Text { text: c.marcas; font-size: 11.5px; font-weight: 700; color: Th.accent; }
            Rectangle {}
        }
        if t.fks.length > 0: Text {
            text: "relações";
            font-size: 11px;
            font-weight: 700;
            color: Th.text-dim;
        }
        for f in t.fks: Text { text: "  " + f; font-size: 12px; color: Th.good; }
        if t.indices.length > 0: Text {
            text: "índices";
            font-size: 11px;
            font-weight: 700;
            color: Th.text-dim;
        }
        for i in t.indices: Text { text: "  " + i; font-size: 12px; color: Th.text-dim; }
    }
}

export component MainWindow inherits Window {
    title: "schematize · database";
    preferred-width: 880px;
    preferred-height: 660px;
    min-width: 640px;
    min-height: 480px;
    background: Th.bg;

    in-out property <bool> dark <=> Th.dark;
    // 0 = Schema · 1 = SQL
    in-out property <int> aba: 0;
    in-out property <string> versao: "—";

    // A FONTE do schema. Nenhuma delas é segredo: são caminho de arquivo e string de conexão
    // sem senha (o `psql` lê a senha do `~/.pgpass` ou do ambiente, como sempre leu).
    in-out property <string> fonte-sqlite;
    in-out property <string> fonte-postgres;
    in-out property <string> fonte-json;

    in-out property <[TabelaUI]> tabelas;
    in-out property <[ArestaUI]> arestas;
    in-out property <string> resumo;
    in-out property <string> erro;
    in-out property <string> msg;
    in-out property <string> sql;

    callback ler();
    callback gerar-sql(bool);   // `true` = migration expand-contract
    callback alternar-tema();
    callback copiar-sql();

    VerticalLayout {
        padding: 18px;
        spacing: 12px;

        HorizontalLayout {
            spacing: 10px;
            VerticalLayout {
                Text {
                    text: "Database";
                    color: Th.header-fg;
                    font-size: 20px;
                    font-weight: 800;
                }
                Text { text: root.versao; font-size: 11.5px; color: Th.text-dim; }
            }
            Rectangle { horizontal-stretch: 1; }
            Btn { label: "Schema"; primary: root.aba == 0; clicked => { root.aba = 0; } }
            Btn { label: "SQL"; primary: root.aba == 1; clicked => { root.aba = 1; } }
            Btn { label: root.dark ? "☾" : "☀"; clicked => { root.alternar-tema(); } }
        }

        Rectangle { height: 1px; background: Th.border; }

        // A FONTE — as três formas que o CLI aceita, e a ordem é a da especificidade.
        VerticalLayout {
            spacing: 6px;
            Text {
                text: "De onde ler o schema — preencha UM dos três";
                font-size: 11.5px;
                font-weight: 700;
                color: Th.text-dim;
            }
            HorizontalLayout {
                spacing: 8px;
                LineEdit { placeholder-text: "arquivo SQLite (ex.: loja.db)"; text <=> root.fonte-sqlite; }
                LineEdit { placeholder-text: "conexão Postgres (lida pelo psql)"; text <=> root.fonte-postgres; }
                LineEdit { placeholder-text: "schema.json"; text <=> root.fonte-json; }
                Btn {
                    label: "Ler";
                    primary: true;
                    // Sem fonte, o CLI devolve erro de uso. Desabilitar aqui evita o
                    // round-trip que só serve para mostrar que faltou preencher.
                    enabled: root.fonte-sqlite != "" || root.fonte-postgres != "" || root.fonte-json != "";
                    clicked => { root.ler(); }
                }
            }
        }

        if root.erro != "": Rectangle {
            height: le.preferred-height + 16px;
            border-radius: 9px;
            border-width: 1px;
            border-color: Th.warn;
            background: Th.surface;
            le := HorizontalLayout {
                padding: 8px;
                Text { text: root.erro; font-size: 12.5px; color: Th.warn; wrap: word-wrap; }
            }
        }
        if root.msg != "": Text { text: root.msg; font-size: 12px; color: Th.good; wrap: word-wrap; }

        // ---- ABA SCHEMA ----
        if root.aba == 0: VerticalLayout {
            vertical-stretch: 1;
            spacing: 8px;
            if root.resumo != "": Text {
                text: root.resumo;
                font-size: 12.5px;
                font-weight: 700;
                color: Th.text;
            }
            if root.tabelas.length == 0 && root.erro == "": Text {
                text: "Nenhuma tabela lida ainda. Preencha uma fonte acima e clique em «Ler».";
                font-size: 12.5px;
                color: Th.text-dim;
                wrap: word-wrap;
            }
            ScrollView {
                vertical-stretch: 1;
                VerticalLayout {
                    spacing: 8px;
                    for t in root.tabelas: FichaTabela { t: t; }
                    if root.arestas.length > 0: Text {
                        text: "grafo do schema — tabela é nó, FK é aresta";
                        font-size: 11.5px;
                        font-weight: 700;
                        color: Th.text-dim;
                    }
                    // Seta em ASCII, como manda o C3: o parser do app lê `A -> B`.
                    for a in root.arestas: Text {
                        text: "  " + a.de + " -> " + a.para + "  (" + a.coluna + ")";
                        font-size: 12px;
                        color: Th.text-dim;
                    }
                }
            }
        }

        // ---- ABA SQL ----
        if root.aba == 1: VerticalLayout {
            vertical-stretch: 1;
            spacing: 8px;
            HorizontalLayout {
                spacing: 8px;
                Btn {
                    label: "Gerar CREATE";
                    primary: true;
                    enabled: root.tabelas.length > 0;
                    clicked => { root.gerar-sql(false); }
                }
                Btn {
                    label: "Gerar migration (expand-contract)";
                    enabled: root.tabelas.length > 0;
                    clicked => { root.gerar-sql(true); }
                }
                Btn { label: "Copiar"; enabled: root.sql != ""; clicked => { root.copiar-sql(); } }
                Rectangle { horizontal-stretch: 1; }
            }
            if root.tabelas.length == 0: Text {
                text: "Leia um schema na aba Schema primeiro — o SQL sai dele.";
                font-size: 12.5px;
                color: Th.text-dim;
                wrap: word-wrap;
            }
            ScrollView {
                vertical-stretch: 1;
                // **Os dois `alignment: start` são o que torna o SQL LEGÍVEL.** Um `Text` solto
                // dentro de um ScrollView fica centrado nos dois eixos, e código centrado não se
                // lê: cada linha começa numa coluna diferente, e a indentação — que no SQL é a
                // estrutura — some.
                VerticalLayout {
                    alignment: start;
                    HorizontalLayout {
                        alignment: start;
                        Text {
                            text: root.sql;
                            font-size: 12px;
                            font-family: "monospace";
                            color: Th.text;
                            horizontal-alignment: left;
                            wrap: word-wrap;
                        }
                    }
                }
            }
        }
    }
}
